{
  "$schema": "https://opencode.ai/config.json",
  // 使用仓库内 .opencode/agents/oceanbase-developer.md。
  "default_agent": "oceanbase-developer",
  "mcp": {
    "oceanbase": {
      "type": "remote",
      "url": "https://mcp.example.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer ${OB_MCP_AUTH_TOKEN}"
      }
    }
  }
}
