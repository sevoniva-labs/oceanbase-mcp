OB_HOST=127.0.0.1
OB_PORT=2883
OB_USER=ob_user@ob_oracle#obcluster
OB_PASSWORD=ob_password
OB_COMPATIBILITY=oracle
OB_ALLOWED_SCHEMAS=OB_USER
# 样例输出脱敏规则，可按需启用
# OB_MASKED_COLUMNS=OB_USER.ORDERS.EMAIL,*.AUDIT_LOG.PAYLOAD
OB_ALLOW_SELECT_STAR=false
OB_MAX_ROWS=100
OB_MAX_RESULT_BYTES=1048576
OB_MAX_CONCURRENT_QUERIES=5
