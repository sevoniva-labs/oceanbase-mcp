NODE_ENV=production
OB_HOST=your-obproxy.example.com
OB_PORT=2883
OB_USER=readonly_user@tenant#cluster
OB_PASSWORD_FILE=/run/secrets/ob_password
OB_COMPATIBILITY=mysql
OB_PRODUCTION=true
OB_MCP_READ_ONLY=true
OB_DB_USER_READ_ONLY=true
OB_ALLOWED_SCHEMAS=app_schema
# 业务字典只用于搜索提示，不授予额外访问权限
# OB_BUSINESS_GLOSSARY_FILE=/etc/ob-mcp/business-glossary.json
OB_ALLOW_SELECT_STAR=false
OB_ENFORCE_READ_ONLY_TX=true
OB_MAX_ROWS=100
OB_MAX_RESULT_BYTES=1048576
OB_MAX_CONCURRENT_QUERIES=5
# 单次工具调用的数据库访问次数上限
OB_MAX_DB_CALLS=40
OB_METADATA_MAX_DB_CALLS=120
OB_ER_MAX_DB_CALLS=240
# 元数据缓存只缓存表结构、约束和关系，不缓存查询结果
OB_METADATA_CACHE_ENABLED=true
OB_METADATA_CACHE_TTL_MS=60000
OB_METADATA_CACHE_MAX_ENTRIES=500
OB_MCP_HOST=127.0.0.1
OB_MCP_PORT=3000
OB_MCP_PATH=/mcp
OB_MCP_AUTH_TOKEN_FILE=/run/secrets/ob_mcp_auth_token
OB_MCP_ALLOWED_HOSTS=mcp.example.com
OB_MCP_ALLOWED_IPS=127.0.0.1,10.0.0.0/8,203.0.113.10
OB_MCP_TRUST_PROXY=1
OB_MCP_METRICS_AUTH_REQUIRED=true
OB_MCP_HEALTH_AUTH_REQUIRED=false
