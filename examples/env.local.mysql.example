OB_HOST=127.0.0.1
OB_PORT=2883
OB_USER=ob_user@ob_mysql#obcluster
OB_PASSWORD=ob_password
OB_COMPATIBILITY=mysql
OB_ALLOWED_SCHEMAS=biz_test
# 样例输出脱敏规则，可按需启用
# OB_MASKED_COLUMNS=biz_test.users.email,*.orders.phone
# 业务字典只用于搜索提示，不授予额外访问权限
# OB_BUSINESS_GLOSSARY_FILE=examples/business-glossary.example.json
OB_ALLOW_SELECT_STAR=false
OB_MAX_ROWS=100
OB_MAX_RESULT_BYTES=1048576
OB_MAX_CONCURRENT_QUERIES=5
