{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "oceanbase": {
      "type": "local",
      "command": ["node", "dist/index.js"],
      "enabled": true,
      "environment": {
        "OB_HOST": "127.0.0.1",
        "OB_PORT": "2883",
        "OB_USER": "ob_user@ob_oracle#obcluster",
        "OB_PASSWORD": "ob_password",
        "OB_COMPATIBILITY": "oracle",
        "OB_ALLOWED_SCHEMAS": "OB_USER",
        "OB_ALLOW_SELECT_STAR": "false"
      }
    }
  }
}
