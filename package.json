{
  "name": "@sevoniva/oceanbase-mcp",
  "version": "1.5.0",
  "description": "Read-only MCP gateway and local developer assistant for OceanBase.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/sevoniva/oceanbase-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sevoniva/oceanbase-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/sevoniva/oceanbase-mcp/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "oceanbase",
    "mcp",
    "opencode",
    "database",
    "read-only"
  ],
  "type": "module",
  "bin": {
    "ob-mcp": "./dist/index.js",
    "ob-mcp-http": "./dist/http.js",
    "ob-mcp-doctor": "./dist/doctor.js"
  },
  "files": [
    "dist",
    "docs/en",
    "docs/zh-CN",
    "deploy",
    "examples",
    ".opencode",
    "README.md",
    ".env.example",
    "Dockerfile",
    "docker-compose.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "config:doctor": "npm run build && node dist/doctor.js",
    "smoke": "npm run build && node dist/smoke.js",
    "mcp:smoke": "npm run build && node scripts/mcp-smoke.mjs",
    "mcp:smoke:oracle": "npm run build && node scripts/mcp-smoke-oracle.mjs",
    "http:smoke": "npm run build && node scripts/http-smoke.mjs",
    "http:smoke:oracle": "npm run build && node scripts/http-smoke-oracle.mjs",
    "docs:check": "node scripts/check-doc-links.mjs README.md docs examples",
    "security:gates": "node scripts/security-gates.mjs",
    "security:secrets": "secretlint '**/*'",
    "security:sca": "npm audit --audit-level=moderate --registry=https://registry.npmjs.org/ && npm audit --omit=dev --audit-level=moderate --registry=https://registry.npmjs.org/",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cytoscape": "^3.34.0",
    "cytoscape-dagre": "^4.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "ipaddr.js": "^1.9.1",
    "mysql2": "^3.22.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "12.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.1",
    "secretlint": "12.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
