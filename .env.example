# 本地开发示例。请按实际 OceanBase 租户修改。
OB_HOST=127.0.0.1
OB_PORT=2883
OB_CLUSTER=obcluster
OB_TENANT=ob_mysql
OB_USERNAME=ob_user
OB_USER=ob_user@ob_mysql#obcluster
OB_PASSWORD=ob_password
OB_COMPATIBILITY=mysql
OB_ALLOWED_SCHEMAS=biz_test
OB_ALLOW_SELECT_STAR=false

# 多 profile 网关示例
# OB_PROFILES=dev,prod
# OB_DEFAULT_PROFILE=dev
# OB_PROFILE_PROD_HOST=your-obproxy.example.com
# OB_PROFILE_PROD_PORT=2883
# OB_PROFILE_PROD_USER=readonly_user@tenant#cluster
# OB_PROFILE_PROD_PASSWORD_FILE=/run/secrets/ob_password
# OB_PROFILE_PROD_COMPATIBILITY=mysql
# OB_PROFILE_PROD_PRODUCTION=true
# OB_PROFILE_PROD_MCP_READ_ONLY=true
# OB_PROFILE_PROD_DB_USER_READ_ONLY=true
# OB_PROFILE_PROD_ALLOWED_SCHEMAS=app_schema

# 可选默认配置
# OB_DATABASE=
# OB_PRODUCTION=false
# OB_MCP_READ_ONLY=true
# OB_DB_USER_READ_ONLY=false
# OB_CONNECTION_LIMIT=5
# OB_CONNECT_TIMEOUT_MS=10000
# OB_QUERY_TIMEOUT_MS=30000
# OB_MAX_ROWS=100
# OB_MAX_RESULT_BYTES=1048576
# OB_MAX_SQL_LENGTH=20000
# OB_MAX_PARAM_COUNT=500
# OB_MAX_CONCURRENT_QUERIES=5
# OB_ENFORCE_READ_ONLY_TX=true
# OB_PASSWORD_FILE=/run/secrets/ob_password
# OB_ALLOWED_TABLES=biz_test.ob_sample,biz_test.*
# OB_DENIED_SCHEMAS=information_schema,mysql,oceanbase,performance_schema,sys
# OB_DENIED_TABLES=
# OB_DENIED_COLUMNS=password,passwd,pwd,secret,token,access_token,refresh_token,api_key,apikey,private_key,credential,credentials,session,cookie
# 样例输出脱敏规则，支持 schema.table.column、table.column、column 和 * 通配
# OB_MASKED_COLUMNS=biz_test.users.email,*.orders.phone,access_token
# OB_ALLOW_SELECT_STAR=false
# OB_REQUIRE_ACCESS_POLICY=false
# OB_INCLUDE_SYSTEM_SCHEMAS=false
# OB_REQUIRE_TLS=false
# OB_SSL=true
# OB_SSL_CA=/path/to/ca.pem
# OB_SSL_CERT=/path/to/client-cert.pem
# OB_SSL_KEY=/path/to/client-key.pem
# OB_SSL_REJECT_UNAUTHORIZED=true

# 远程 Streamable HTTP MCP 服务配置
# OB_MCP_HOST=127.0.0.1
# OB_MCP_PORT=3000
# OB_MCP_PATH=/mcp
# OB_MCP_AUTH_TOKEN=
# OB_MCP_AUTH_TOKEN_FILE=/run/secrets/ob_mcp_auth_token
# OB_MCP_AUTH_TOKENS_FILE=/run/secrets/ob_mcp_auth_tokens.json
# OB_MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# OB_MCP_ALLOWED_IPS=127.0.0.1,10.0.0.0/8,203.0.113.10
# OB_MCP_TRUST_PROXY=false
# OB_MCP_METRICS_AUTH_REQUIRED=false
# OB_MCP_HEALTH_AUTH_REQUIRED=false
# OB_MCP_CLIENT_ID_HEADER=x-ob-mcp-client-id
# OB_MCP_BODY_LIMIT=256kb
# OB_MCP_RATE_LIMIT_WINDOW_MS=60000
# OB_MCP_RATE_LIMIT_MAX=60
